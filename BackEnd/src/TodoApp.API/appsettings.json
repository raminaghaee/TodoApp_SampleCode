{
  "ConnectionStrings": {
    "TodoAppConnectionString": "Server=.\\DEVELOPER; Database=TodoAppDb1; Integrated Security=SSPI; TrustServerCertificate=True"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "retainedFileCountLimit": 30,
          "formatter": {
            "type": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "TodoApp.API"
    }
  },
  "Jwt": {
    "Issuer": "TodoApp.API",
    "Audience": "TodoApp.Client",
    "Key": "",
    "AccessTokenExpirationMinutes": 15
  },
  "Hangfire": {
    "EnableDashboard": false,
    "CleanupCron": "0 0 * * *"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8080"
    ]
  },
  "Security": {
    "FrontendBaseUrl": "http://localhost:8080",
    "AllowedRedirectOrigins": [
      "http://localhost:8080"
    ],
    "PasswordResetPath": "/reset-password",
    "ConfirmEmailPath": "/confirm-email",
    "PasswordResetTokenLifetimeMinutes": 60,
    "EmailChangeTokenLifetimeMinutes": 1440,
    "RequireConfirmedEmailForReset": false,
    "PasswordMinLength": 8
  }
}
